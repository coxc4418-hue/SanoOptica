rules_version = '2';

// SanoÓptica — Reglas de seguridad multisede
// - Cada óptica (cuenta) solo accede a sus propios datos en tenants/{uid}.
// - El administrador general crea, congela, renueva y elimina sedes.
// - Una sede congelada o con el plan vencido no puede leer ni escribir sus datos.
// - Las demos (sesión anónima) caducan a los 30 minutos: después solo pueden borrar sus datos.
// - portals/{código}: portal público de cada paciente (kind 'paciente'); se lee por código exacto, sin listar.
// - rx/{código}: datos públicos para verificar una fórmula óptica por su QR.
// - bookings/{código}: agenda en línea de la óptica (horario y horas ocupadas, sin datos de pacientes).
// - inbox/{id}: pagos reportados desde el portal y citas pedidas en línea.
//   Se crean validados desde las páginas públicas; solo la óptica dueña los ve, los procesa y los borra.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == 'admin@sanooptica.app'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isAnon() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isOwner(tenantId) {
      return signedIn() && request.auth.uid == tenantId;
    }

    function tenantData(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data;
    }

    // Activa = no congelada, no eliminada y con el plan vigente (si tiene fecha de vencimiento)
    function tenantActive(tenantId) {
      let t = tenantData(tenantId);
      let paid = t.get('paidUntil', null);
      return t.get('active', true) == true
        && t.get('deleted', false) != true
        && (paid == null || paid > request.time);
    }

    // Una demo solo puede crear/modificar datos mientras no haya vencido
    function demoValid(tenantId) {
      let t = tenantData(tenantId);
      return t.get('demo', false) != true || t.expiresAt > request.time;
    }

    function ownerCanWrite() {
      return signedIn() && tenantActive(request.auth.uid) && demoValid(request.auth.uid);
    }

    // Documentos públicos de la óptica (portales, fórmulas, agenda): solo su dueña los escribe
    function publicCreate(code) {
      return isSuperAdmin()
        || (signedIn() && code.matches('^[A-Z0-9]{6,12}$')
            && request.resource.data.tenantId == request.auth.uid && ownerCanWrite());
    }
    function publicUpdate() {
      return isSuperAdmin()
        || (signedIn() && resource.data.tenantId == request.auth.uid
            && request.resource.data.tenantId == request.auth.uid && ownerCanWrite());
    }
    function publicDelete() {
      return isSuperAdmin() || (signedIn() && resource.data.tenantId == request.auth.uid);
    }

    // Usuario → correo (para iniciar sesión con el nombre de usuario)
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow write: if isSuperAdmin();
    }

    // Avisos generales del administrador para todas las sedes
    match /system/{docId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // Portal público del paciente: se lee por código exacto (nunca se listan)
    match /portals/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if publicCreate(code);
      allow update: if publicUpdate();
      allow delete: if publicDelete();
    }

    // Verificación pública de fórmulas ópticas
    match /rx/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if publicCreate(code);
      allow update: if publicUpdate();
      allow delete: if publicDelete();
    }

    // Agenda en línea de la óptica
    match /bookings/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if publicCreate(code);
      allow update: if publicUpdate();
      allow delete: if publicDelete();
    }

    // ---------------- Bandeja ----------------
    function shortStr(d, k, max) {
      return d.get(k, '') is string && d.get(k, '').size() <= max;
    }
    function optNum(d, k) {
      return d.get(k, null) == null || (d.get(k, 0) is number && d.get(k, 0) >= 0 && d.get(k, 0) <= 1000000000000);
    }
    function validInbox(d) {
      return d.keys().hasOnly(['tenantId', 'code', 'who', 'type', 'status', 'createdAt',
          'patientName', 'patientCode', 'orderId', 'orderNumber',
          'amount', 'amountBs', 'rate', 'method', 'date', 'bank', 'reference', 'payer', 'note',
          'name', 'phone', 'idDoc', 'reason', 'time'])
        && d.keys().hasAll(['tenantId', 'code', 'type', 'status', 'createdAt'])
        && d.tenantId is string && d.tenantId.size() > 0 && d.tenantId.size() <= 128
        && d.code is string && d.code.size() >= 6 && d.code.size() <= 12
        && shortStr(d, 'who', 64)
        && d.status == 'nueva'
        && d.createdAt is string && d.createdAt.size() <= 30
        && shortStr(d, 'note', 200)
        && (
          (d.type == 'pago'
            && d.orderId is string && d.orderId.size() > 0 && d.orderId.size() <= 64
            && shortStr(d, 'orderNumber', 20) && shortStr(d, 'patientName', 80) && shortStr(d, 'patientCode', 20) && shortStr(d, 'payer', 80)
            && d.amount is number && d.amount > 0 && d.amount <= 1000000000
            && optNum(d, 'amountBs') && optNum(d, 'rate')
            && shortStr(d, 'method', 30) && shortStr(d, 'date', 10) && shortStr(d, 'bank', 60)
            && d.reference is string && d.reference.size() >= 3 && d.reference.size() <= 40)
          || (d.type == 'cita'
            && d.name is string && d.name.size() >= 3 && d.name.size() <= 80
            && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 20
            && shortStr(d, 'idDoc', 20)
            && d.reason in ['examen', 'control', 'contacto', 'ajuste', 'ninos', 'entrega']
            && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$'))
        );
    }
    // El portal debe existir, estar activo y pertenecer a esa óptica y a ese paciente
    function portalAllows(d) {
      let path = /databases/$(database)/documents/portals/$(d.code);
      let p = get(path).data;
      return d.type == 'pago' && exists(path) && p.kind == 'paciente' && p.tenantId == d.tenantId
        && p.who == d.get('who', '') && p.get('active', true) == true && p.allow.reports == true;
    }
    // La agenda en línea debe existir, estar activa y pertenecer a esa óptica
    function bookingAllows(d) {
      let path = /databases/$(database)/documents/bookings/$(d.code);
      let c = get(path).data;
      return d.type == 'cita' && exists(path) && c.tenantId == d.tenantId && c.get('active', true) == true;
    }
    match /inbox/{id} {
      allow create: if (validInbox(request.resource.data)
            && (request.resource.data.type == 'cita' ? bookingAllows(request.resource.data) : portalAllows(request.resource.data)))
        || (signedIn() && request.resource.data.tenantId == request.auth.uid && ownerCanWrite());
      allow get, list: if isSuperAdmin() || (signedIn() && resource.data.tenantId == request.auth.uid);
      allow update: if isSuperAdmin()
        || (signedIn() && resource.data.tenantId == request.auth.uid
            && request.resource.data.tenantId == resource.data.tenantId && ownerCanWrite());
      allow delete: if isSuperAdmin() || (signedIn() && resource.data.tenantId == request.auth.uid);
    }

    match /tenants/{tenantId} {
      allow get: if isSuperAdmin() || isOwner(tenantId);
      allow list: if isSuperAdmin();

      // Las sedes las crea el administrador. Una sesión anónima solo puede crear su demo (máx. 31 min).
      allow create: if isSuperAdmin()
        || (isOwner(tenantId) && isAnon()
            && request.resource.data.demo == true
            && request.resource.data.active == true
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.expiresAt <= request.time + duration.value(31, 'm'));

      // La sede solo puede cambiar su nombre visible; estado, plan y vencimiento los maneja el administrador.
      allow update: if isSuperAdmin()
        || (isOwner(tenantId) && tenantActive(tenantId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']));

      allow delete: if isSuperAdmin() || (isOwner(tenantId) && resource.data.get('demo', false) == true);

      // Datos de la óptica: pacientes, exámenes, órdenes, pagos, inventario, laboratorios, citas, gastos...
      match /{collection}/{docId} {
        allow read: if isSuperAdmin() || (isOwner(tenantId) && tenantActive(tenantId));
        allow delete: if isSuperAdmin() || (isOwner(tenantId) && (tenantActive(tenantId) || tenantData(tenantId).get('demo', false) == true));
        allow create, update: if isSuperAdmin() || (isOwner(tenantId) && tenantActive(tenantId) && demoValid(tenantId));
      }
    }

    // Cualquier otra ruta queda bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
